RewriteEngine On
RewriteBase /

# Force HTTPS (Hostinger handles SSL termination, so only redirect when truly HTTP)
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# /downloads (plural) is the PDF asset folder and answers 403 without an
# index — send the browser to the real download page, /download
# (singular). Exact match only, so /downloads/*.pdf keeps working.
RewriteRule ^downloads/?$ /download [R=301,L]

# Never send missing JavaScript/CSS asset requests through the SPA fallback.
# A missing asset should be a clear 404, not index.html returned as JavaScript.
RewriteRule ^assets/ - [L]

# Story embeds: serve the lightweight static card (public/embed.html) for
# /embed/story/<slug>. The full SPA is heavy, boots auth/router/Convex client
# and gets torn down by iframe refreshes (the reported "error when changing
# pages or refreshing" on the embed). The static card has no boot sequence,
# no session and one fetch, so the embed survives refresh and navigation.
RewriteRule ^embed/story/([A-Za-z0-9_-]+)/?$ embed.html [L]

# Prerendered per-route pages: internally rewrite /lore (or /lore/)
# → lore.html when that file exists (flat sibling of index.html).
# Internal rewrite, NOT a redirect — clean URLs serve unique crawler-first
# HTML directly. Safe against loops: the -f check fails for
# lore.html.html, so an already-rewritten URL passes through.
#
# Nested routes are prerendered as FLAT dashed files, so this rule is tried
# FIRST: /tools/assistant → tools-assistant.html, /lore/submit →
# lore-submit.html, /fleet-registry/armament-sheets →
# fleet-registry-armament-sheets.html. They must not live in a subdirectory
# (/lore/submit.html inside a real lore/ directory) because mod_dir would then
# 301 /lore → /lore/ and an indexed URL would start answering with a redirect
# instead of lore.html. Dashed first also means a leftover nested page from an
# older deploy can never win over the current flat file.
RewriteCond %{DOCUMENT_ROOT}/$1-$2.html -f
RewriteRule ^(.+?)/([^/]+?)/?$ $1-$2.html [L]

RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# SPA fallback — serve index.html for all client-side routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Cache hashed assets
<FilesMatch "\.(js|css|svg|woff2|png|jpg|jpeg|gif|ico|ttf|eot)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# No-cache index.html
<Files "index.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>

# The armory console is a FILE to download and upload to the armory
# subdomain, not a page to browse. Without an explicit attachment header the
# browser renders the .html inline (and opening the URL directly ignores the
# <a download> hint), so the operator never gets a file to upload.
<Files "armory-console.html">
  ForceType application/octet-stream
  Header set Content-Disposition "attachment; filename=armory-console.html"
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>
