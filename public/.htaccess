RewriteEngine On
RewriteBase /

# Force HTTPS (Hostinger handles SSL termination, so only redirect when truly HTTP)
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Never send missing JavaScript/CSS asset requests through the SPA fallback.
# A missing asset should be a clear 404, not index.html returned as JavaScript.
RewriteRule ^assets/ - [L]

# SPA fallback — serve index.html for all client-side routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Cache hashed assets
<FilesMatch "\.(js|css|svg|woff2|png|jpg|jpeg|gif|ico|ttf|eot)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# No-cache index.html
<Files "index.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>
